{
  "schemaVersion": 1,
  "endpoint": "https://eastus2-3.in.applicationinsights.azure.com/v2/track",
  "instrumentationKey": "963d68d0-40ec-4dcb-ad11-48c8abacd67c",
  "hosts": ["vscode", "intellij", "cli", "browser"],
  "platforms": ["darwin", "win32", "linux", "unknown"],
  "architectures": ["arm64", "x64", "unknown"],
  "enums": {
    "errorType": ["timeout", "memory_error", "parse", "not_found", "permission", "server_spawn", "cancelled", "killed", "pipe_broken", "protocol", "unknown"],
    "phase": ["input", "loading", "graph_building", "graph_built", "dominators", "query", "output", "server_start", "unknown"],
    "signal": ["none", "SIGKILL", "SIGTERM", "SIGSEGV", "SIGABRT", "SIGBUS", "other"],
    "exitCode": ["0", "1", "2", "3", "4", "5", "6", "137", "139", "unknown"],
    "keyword": ["select", "group_by", "where", "order_by", "instances", "retained", "count", "other"],
    "tab": ["overview", "histogram", "domtree", "leaks", "waste", "source", "query", "compare", "timeline", "monitor", "chat", "unknown"],
    "provider": ["anthropic", "openai", "gemini", "deepseek", "mistral", "groq", "xai", "together", "openrouter", "ollama"],
    "format": ["json", "report", "csv", "compare-markdown", "compare-csv", "text"],
    "tier": ["workspace", "source-jar", "decompiled", "dependency", "none"],
    "status": ["diff-opened", "already-fixed", "source-not-found", "cancelled", "error"],
    "command": ["default", "analyze", "leaks", "explain", "query", "compare"],
    "ruleId": ["heap-growth", "new-leak-suspects", "class-explosion", "resolved-leaks"],
    "severity": ["warning", "info"]
  },
  "metrics": {
    "fileSizeMB": {"max": 1048576, "quantum": 64},
    "heapSizeMB": {"max": 1048576, "quantum": 64},
    "durationMs": {"max": 86400000, "quantum": 100},
    "elapsedMinutes": {"max": 1440, "quantum": 1},
    "objectCount": {"max": 1000000000000, "quantum": 1000},
    "classCount": {"max": 10000000, "quantum": 100},
    "leakSuspectCount": {"max": 10000000, "quantum": 10},
    "consecutiveFailures": {"max": 100, "quantum": 1}
  },
  "events": {
    "analysis/started": {"category": "usage", "properties": [], "measurements": ["fileSizeMB"]},
    "analysis/phase": {"category": "usage", "properties": ["phase"], "measurements": []},
    "analysis/completed": {"category": "usage", "properties": [], "measurements": ["durationMs", "objectCount", "classCount", "leakSuspectCount", "heapSizeMB"]},
    "analysis/cancelled": {"category": "usage", "properties": [], "measurements": []},
    "analysis/longRunning": {"category": "usage", "properties": [], "measurements": ["elapsedMinutes"]},
    "analysis/failed": {"category": "error", "properties": ["errorType", "phase"], "measurements": ["durationMs"]},
    "analysis/retry": {"category": "usage", "properties": [], "measurements": []},
    "analysis/recovered": {"category": "usage", "properties": [], "measurements": []},
    "error/serverCrashed": {"category": "error", "properties": ["exitCode", "signal", "phase", "errorType"], "measurements": []},
    "error/heartbeatFailed": {"category": "error", "properties": [], "measurements": ["consecutiveFailures"]},
    "query/failed": {"category": "error", "properties": ["errorType", "phase"], "measurements": []},
    "feature/queryExecuted": {"category": "usage", "properties": ["keyword"], "measurements": []},
    "feature/tabViewed": {"category": "usage", "properties": ["tab"], "measurements": []},
    "feature/chatMessage": {"category": "usage", "properties": ["provider"], "measurements": []},
    "feature/copilotChat": {"category": "usage", "properties": ["command"], "measurements": []},
    "feature/goToSource": {"category": "usage", "properties": ["tier"], "measurements": []},
    "feature/fixWithAi": {"category": "usage", "properties": ["status"], "measurements": []},
    "feature/compareHeaps": {"category": "usage", "properties": [], "measurements": []},
    "feature/export": {"category": "usage", "properties": ["format"], "measurements": []},
    "feature/gcRootPath": {"category": "usage", "properties": [], "measurements": []},
    "feature/inspectObject": {"category": "usage", "properties": [], "measurements": []},
    "feature/explainObject": {"category": "usage", "properties": [], "measurements": []},
    "feature/explainLeakSuspect": {"category": "usage", "properties": [], "measurements": []},
    "alert/fired": {"category": "usage", "properties": ["ruleId", "severity"], "measurements": []},
    "alert/viewComparison": {"category": "usage", "properties": ["ruleId"], "measurements": []}
  }
